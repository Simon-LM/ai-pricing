  "_comment_tools": [
    "The tools table prices each row in a sentence. Each row read is named here by its",
    "Tool and Details cells, with the pattern its price must match (`amount` is the",
    "figure) and the field it becomes. A row not named here is reported and not read; a",
    "row named here that the table lacks, or prices another way, fails the run.",
    "Containers state one price per memory size, `variant`, each published as its own",
    "entry, `containers (4 GB)`, priced per 20-minute session as the page states it."
  ],
  "tools": [
    {
      "tool": "Web search",
      "details": "Web search (incl. images)",
      "key": "web_search",
      "pattern": "\\$(?P<amount>[0-9]+(?:\\.[0-9]+)?) / 1k calls",
      "field": "per_1k_calls"
    },
    {
      "tool": "Web search",
      "details": "Web search preview (reasoning models)",
      "key": "web_search_preview (reasoning models)",
      "pattern": "\\$(?P<amount>[0-9]+(?:\\.[0-9]+)?) / 1k calls",
      "field": "per_1k_calls"
    },
    {
      "tool": "Web search",
      "details": "Web search preview (other models)",
      "key": "web_search_preview (other models)",
      "pattern": "\\$(?P<amount>[0-9]+(?:\\.[0-9]+)?) / 1k calls",
      "field": "per_1k_calls"
    },
    {
      "tool": "Containers",
      "details": "Hosted Shell and Code Interpreter",
      "key": "containers",
      "pattern": "(?P<size>[0-9]+) GB \\$(?P<amount>[0-9]+(?:\\.[0-9]+)?)",
      "variant": "size",
      "unit": "per 20-minute session per container",
      "field": "per_session"
    },
    {
      "tool": "File search",
      "details": "Storage",
      "key": "file_search (storage)",
      "pattern": "\\$(?P<amount>[0-9]+(?:\\.[0-9]+)?) / GB per day",
      "field": "per_gb_day"
    },
    {
      "tool": "File search",
      "details": "Tool call",
      "key": "file_search",
      "pattern": "\\$(?P<amount>[0-9]+(?:\\.[0-9]+)?) / 1k calls",
      "field": "per_1k_calls"
    },
    {
      "tool": "Agent Kit",
      "details": "ChatKit file and image upload storage",
      "key": "chatkit (storage)",
      "pattern": "\\$(?P<amount>[0-9]+(?:\\.[0-9]+)?) / GB-day",
      "field": "per_gb_day"
    }
  ]
